# Supabase — from your Supabase project's Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — from resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Basecamp <alerts@yourdomain.com>

# A random string (16+ chars) — you make this up yourself.
# Set the SAME value in Vercel's Environment Variables so cron requests are verified.
CRON_SECRET=
